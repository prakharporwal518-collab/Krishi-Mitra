# Hugging Face model (PlantVillage, 38 classes)
# Leave empty to use the bundled field-photo model (models/krishi-mobilenetv2-field)
HF_MODEL_ID=
# Below this confidence the app asks the farmer to retake the photo
MIN_CONFIDENCE=0.6
# Optional: vision-LLM fallback if the HF model cannot be loaded
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional: dynamic translation for Telugu / Tamil / Bengali recommendations
GOOGLE_TRANSLATE_API_KEY=
# Comma-separated allowed origins
CORS_ORIGINS=*
